name = "zhangbowen2006/moonkeyguard"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/zhangbowen2006/MoonKeyguard.git"

license = "Apache-2.0"

keywords = [
  "keymap",
  "keyboard",
  "shortcut",
  "static-analysis",
  "accessibility",
  "ci",
]

preferred_target = "wasm"

description = "MoonBit-native keyboard shortcut conflict, context, platform, accessibility, and CI analysis toolkit."
